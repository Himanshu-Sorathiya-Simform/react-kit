{
	"name": "@himanshu-sorathiya/react-kit",
	"version": "1.0.4",
	"description": "An opinionated collection of react hooks, and reusable UI components.",
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/index.css"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && dts-bundle-generator --project tsconfig.app.json -o dist/index.d.ts src/index.ts",
		"lint": "eslint .",
		"preview": "vite preview",
		"format": "prettier . --write"
	},
	"dependencies": {
		"@tanstack/react-store": "^0.11.0"
	},
	"peerDependencies": {
		"react": "^17.0.0 || ^18.0.0 || ^19.0.0",
		"react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.12.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"dts-bundle-generator": "^9.5.1",
		"eslint": "^10.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.12"
	},
	"sideEffects": [
		"**/*.css"
	],
	"keywords": [
		"react",
		"react-kit",
		"hooks",
		"components",
		"state-management"
	],
	"homepage": "https://github.com/Himanshu-Sorathiya-Simform/react-kit#readme",
	"bugs": {
		"url": "https://github.com/Himanshu-Sorathiya-Simform/react-kit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Himanshu-Sorathiya-Simform/react-kit.git"
	},
	"license": "MIT",
	"author": "Himanshu Sorathiya"
}
